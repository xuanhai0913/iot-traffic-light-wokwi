classDiagram
    class TrafficLight {
        +begin()
        +setColor(color)
        +turnOff()
    }

    class RoadApproach {
        +setColor(color)
        +allOff()
        +name()
    }

    class PedestrianSignal {
        +setWalk(enabled)
    }

    class ModeManager {
        +setMode(mode)
        +cycleButtonMode()
        +parseCommand(command)
    }

    class PhaseConfig {
        +greenSeconds()
        +yellowSeconds()
        +setDuration(phase, seconds)
    }

    class DisplayManager {
        +showMode(mode)
        +showPhase(phase)
        +showCountdown(seconds)
    }

    class EventLog {
        +add(level, message)
        +recentEntries()
    }

    class IModeStrategy {
        <<interface>>
        +enter()
        +tick(nowMs)
        +phaseCode()
    }

    class AutoMode
    class NightMode
    class PriorityNSMode
    class PriorityEWMode
    class EmergencyMode
    class MaintenanceMode

    class IntersectionController {
        +begin()
        +update()
        +applyExternalCommand(cmd)
        +buildStatusJson()
    }

    class MqttClientManager {
        +connect()
        +handleIncomingCommand()
        +publishStatus()
        +publishAck()
    }

    class TrafficRepository {
        +InsertCommandAsync()
        +MarkCommandPublishedAsync()
        +UpsertDeviceStatusAsync()
    }

    class TrafficService {
        +HandleCommandAsync()
        +GetDashboardAsync()
        +UpdatePhasePlanDurationsAsync()
    }

    class ITrafficCommandPublisher {
        <<interface>>
        +PublishCommandAsync()
    }

    class MqttTrafficBridge {
        +PublishCommandAsync()
        +StartAsync()
    }

    RoadApproach --> TrafficLight
    RoadApproach --> PedestrianSignal
    IntersectionController --> ModeManager
    IntersectionController --> PhaseConfig
    IntersectionController --> DisplayManager
    IntersectionController --> EventLog
    IntersectionController --> IModeStrategy
    IModeStrategy <|.. AutoMode
    IModeStrategy <|.. NightMode
    IModeStrategy <|.. PriorityNSMode
    IModeStrategy <|.. PriorityEWMode
    IModeStrategy <|.. EmergencyMode
    IModeStrategy <|.. MaintenanceMode
    MqttClientManager --> IntersectionController
    TrafficService --> TrafficRepository
    TrafficService --> ITrafficCommandPublisher
    ITrafficCommandPublisher <|.. MqttTrafficBridge
    MqttTrafficBridge --> TrafficRepository
